{
  "version": 2,
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/router.js": {
      "maxDuration": 60,
      "includeFiles": "server/**"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/router"
    },
    {
      "source": "/:path*",
      "destination": "/api/router?route=:path*"
    }
  ]
}
